# ═══════════════════════════════════════════════════════════════════
# .gitignore — Tells Git which files/folders to NEVER track or commit
#
# Why this matters: Git tracks every file in your project by default.
# Some files are auto-generated, huge, or contain secrets — those
# should never be in your repo. This file is your filter.
#
# Rule: if it's in here, `git add .` won't touch it. Ever.
# ═══════════════════════════════════════════════════════════════════


# ── Dependencies ──────────────────────────────────────────────────
# node_modules/ is where npm installs all your packages.
# It can be 200MB+ and is ALWAYS re-generated by `npm install`.
# Never commit it — anyone cloning your repo just runs `npm install`
# and gets the exact same packages from package-lock.json.
node_modules


# ── Build Outputs ─────────────────────────────────────────────────
# These folders are generated when you run `npm run build`.
# They contain the compiled, optimized version of your app.
# Never commit them — Vercel builds fresh from source on every deploy.
.output
/build


# ── SvelteKit Internal ────────────────────────────────────────────
# .svelte-kit/ is auto-generated by SvelteKit during dev and build.
# Contains internal type definitions, route manifests, and cache.
# Regenerated automatically — never needs to be in Git.
/.svelte-kit


# ── Deployment Platform Folders ───────────────────────────────────
# Each platform creates its own config folder when you link your project.
# .vercel/  → created by `vercel link` (contains your project ID)
# .netlify/ → created by Netlify CLI
# .wrangler/→ created by Cloudflare Workers CLI
# These are machine-specific and should never be shared via Git.
.vercel
.netlify
.wrangler


# ── Operating System Junk ─────────────────────────────────────────
# macOS creates .DS_Store files in every folder you open in Finder.
# Windows creates Thumbs.db for folder thumbnail cache.
# Neither has anything to do with your code — keep them out.
.DS_Store
Thumbs.db


# ── Environment Variables ─────────────────────────────────────────
# These files contain your REAL secrets: API keys, tokens, passwords.
# If any of these end up on GitHub, your keys are compromised.
# Rotate them immediately if that ever happens.
#
# .env              → generic fallback (ignored to be safe)
# .env.local        → personal local overrides
# .env.development  → local dev environment values
# .env.production   → production values (pushed to Vercel via `make sync-env`)
# .env.*.local      → any environment-specific local overrides
.env
.env.local
.env.development
.env.production
.env.*.local

# EXCEPTION: .env.example is safe to commit.
# It contains fake placeholder values only — no real secrets.
# It documents what env vars the project needs for anyone cloning the repo.
!.env.example


# ── Vite Temp Files ───────────────────────────────────────────────
# Vite creates temporary timestamp files when bundling your config.
# They're ephemeral build artifacts — not part of your source code.
vite.config.js.timestamp-*
vite.config.ts.timestamp-*


# ── tempScripts Folder ─────────────────────────────────────────────
# This is where I keep personal scripts for development and deployment.
# It's not part of the core project and may contain sensitive info.
tempScripts
.vscode

local.db