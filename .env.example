# ═══════════════════════════════════════════════════════════════════
# .env.example — COMMIT THIS FILE. No real values here.
# ═══════════════════════════════════════════════════════════════════
#
# PURPOSE:
#   Documents every env var the project needs.
#   Anyone cloning the repo knows exactly what to fill in.
#   Safe to commit — contains only structure, never secrets.
#
# SETUP:
#   cp .env.example .env.development   → fill with real dev values
#   cp .env.example .env.production    → fill with real prod values
#   Production vars pushed to Vercel via: make sync-env
#
# NAMING CONVENTION:
#   No prefix   → PRIVATE. Server-only. Never sent to browser.
#                 Accessible via: import { VAR } from '$env/static/private'
#                 Only usable in: +page.server.js, +layout.server.js, +server.js
#
#   PUBLIC_     → BROWSER-SAFE. Not a secret. Config the browser needs.
#                 Accessible via: import { PUBLIC_VAR } from '$env/static/public'
#                 Usable anywhere including .svelte components.
#
# ─── PRIVATE — Server Only ────────────────────────────────────────
# Used in +layout.server.js to fetch GitHub profile and construct URLs.
# Never reaches the browser — token stays server-side.
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx       # github.com/settings/tokens → read:user, public_repo
GITHUB_USERNAME=yourusername                # your GitHub handle
LINKEDIN_USERNAME=yourlinkedinusername      # your LinkedIn handle

# ─── PUBLIC — Browser Safe ────────────────────────────────────────
# Used in config.js for SEO canonical URL and contact link.
# Not secrets — these are public URLs anyway.
PUBLIC_SITE_URL=https://yourportfolio.vercel.app   # update after first Vercel deploy
PUBLIC_EMAIL=your@email.com                        # shown in About/Connect section
PUBLIC_SPOTIFY_PLAYLIST_URL=https://open.spotify.com/playlist/yourplaylistid  # optional, shown in About section

# ─── DEV FLAGS — Development Only ────────────────────────────────
# Toggle these to control dev behaviour — restart server after changing.
#
# PUBLIC_DEV_STRICT controls:
#   true  → Dev environment simulates production completely. No dev shortcuts.
#   false → Dev environment has shortcuts to speed up development (e.g. auto-login, skipping delays).

PUBLIC_DEV_STRICT=false  # If true, dev environment behaves exactly like production.


# ── Availability Status ────────────────────────────────────────────
# This is the single source of truth for current work status.
#
# VALID VALUES:
#   open           → Actively looking for full-time roles
#   contract       → Available for contract / freelance work only
#   opportunities  → Open to selective / interesting opportunities
#   closed         → Not currently available
#
# EXAMPLES:
#   PUBLIC_AVAILABILITY_STATUS=open
#   PUBLIC_AVAILABILITY_STATUS=contract
#   PUBLIC_AVAILABILITY_STATUS=opportunities
#   PUBLIC_AVAILABILITY_STATUS=closed
#
# DEFAULT BEHAVIOUR:
#   If this variable is missing or invalid,
#   the app will fallback to: closed
#
# HOW TO UPDATE (PRODUCTION):
#   1. Edit .env.production
#   2. Run: make sync-env
#   3. This pushes env to Vercel and triggers rebuild

PUBLIC_AVAILABILITY_STATUS=open

# ── Database ──────────────────────────────────────────────────
# Local dev: TURSO_DB_URL=file:local.db, TURSO_AUTH_TOKEN=
# Production: get from turso.io dashboard after deployment
TURSO_DB_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-token-here

# Required — Gemini primary (free)
GOOGLE_AI_KEY=your-google-ai-key-here
GEMINI_MODEL=gemini-flash-latest

# Optional — only if you want a fallback
AI_FALLBACK_PROVIDER=define-your-fallback-provider-here  # e.g. openai
AI_FALLBACK_MODEL=specify-fallback-model-here  # e.g. gpt-3.5-turbo
AI_FALLBACK_API_KEY=your-fallback-api-key-here  # e.g. OpenAI API key

# ── Owner Interface ──────────────────────────────────────────────
# Only required in production — dev environment skips auth entirely.
# Use a strong random password: openssl rand -base64 32
OWNER_PASSWORD=your-owner-password-here

VISITOR_HASH_SECRET=your-visitor-hash-secret-here  # Used to hash visitor IPs for analytics. Keep this secret and random.