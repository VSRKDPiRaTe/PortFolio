# ═══════════════════════════════════════════════════════════════════
# .npmrc — npm Configuration File
#
# This file configures how npm behaves for THIS project specifically.
# It lives at the root of your project and overrides any global npm
# settings on any machine that runs `npm install` here.
#
# Why this matters: ensures every developer (and Vercel's build server)
# uses npm the same way — same Node version enforcement, same install
# behavior, no surprises between machines.
# ═══════════════════════════════════════════════════════════════════


# ── Engine Strict ─────────────────────────────────────────────────
# Forces npm to respect the "engines" field in package.json.
# If someone tries to run this project on an incompatible Node version,
# npm will REFUSE to install and throw an error instead of silently
# proceeding and causing weird runtime bugs.
#
# Only works if you define engines in package.json.
# Example error you'd see: "npm ERR! engine Unsupported engine"
engine-strict=true


# ── Save Exact ────────────────────────────────────────────────────
# When you run `npm install some-package`, npm normally saves it as:
#   "some-package": "^1.2.3"  ← the ^ means "allow minor updates"
#
# With save-exact=true it saves as:
#   "some-package": "1.2.3"   ← exact version, no surprises
#
# Why: package-lock.json already locks versions, but this makes
# package.json itself explicit too. No accidental version drift
# when someone runs npm install months later.
save-exact=true


# ── Legacy Peer Deps ──────────────────────────────────────────────
# npm v7+ added strict peer dependency checking which causes install
# errors when packages have slightly mismatched peer dep declarations.
# Setting this to false keeps strict mode ON (the correct behavior).
# If you ever hit peer dep conflicts during install, flip to true
# temporarily — but always try to fix the root cause instead.
legacy-peer-deps=false


# ── Fund ──────────────────────────────────────────────────────────
# By default npm shows "X packages are looking for funding" after
# every install. Useful to know once, annoying every time.
# This silences it without hiding actual warnings or errors.
fund=false


# ── Audit Level ───────────────────────────────────────────────────
# Controls which severity of security vulnerabilities cause `npm audit`
# to exit with an error code (which would fail a CI/CD pipeline).
#
# Options: low | moderate | high | critical
# Setting to "high" means low/moderate vulnerabilities are reported
# but won't block your build. Critical and high will.
# Adjust to "moderate" if you want stricter CI enforcement.
audit-level=high